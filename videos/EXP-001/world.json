      "LAMP-EXT-01 must remain farther from CABIN-01 than LAMP-EXT-02",
      "FENCE-01 must remain on the same physical side of PATH-01",
      "vegetation density and tree-line distance must remain stable"
    ],

    "allowed_causes_of_visual_change": [
      "camera_translation",
      "camera_rotation",
      "perspective",
      "occlusion",
      "depth",
      "lens_change",
